{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repeat After Me",
  "version": "1.0.1",
  "identifier": "app.repeatafterme",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Repeat After Me",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' ram: http://ram.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Repeat after the teacher, hear yourself, decide.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../vendor/models/ggml-small.en-q5_1.bin": "models/ggml-small.en-q5_1.bin"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": { "depends": ["libasound2", "libwebkit2gtk-4.1-0"] }
    }
  }
}
